  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "HTTP & API Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "API Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri, method)",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, uri))",
          "legendFormat": "{{uri}} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 3,
      "title": "API Errors (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} ({{status}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "Search & Reranking",
      "type": "row"
    },
    {
      "id": 4,
      "title": "Search Requests by Mode",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(aikp_search_requests_total[1m])) by (mode, outcome)",
          "legendFormat": "{{mode}} ({{outcome}})"
        }
      ]
    },
    {
      "id": 5,
      "title": "Search Latency (Mean & Max)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(aikp_search_latency_seconds_sum[1m]) / rate(aikp_search_latency_seconds_count[1m])",
          "legendFormat": "Avg Latency {{mode}}"
        },
        {
          "expr": "aikp_search_latency_seconds_max",
          "legendFormat": "Max Latency {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "title": "Reranking Latency & Fallbacks",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(aikp_rerank_latency_seconds_sum[1m]) / rate(aikp_rerank_latency_seconds_count[1m])",
          "legendFormat": "Avg Rerank Latency"
        },
        {
          "expr": "rate(aikp_rerank_fallbacks_total[1m])",
          "legendFormat": "Fallback Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "RAG, Cache & Document Processing",
      "type": "row"
    },
    {
      "id": 7,
      "title": "RAG Latency (Retrieval vs Generation)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(aikp_rag_retrieval_latency_seconds_sum[1m]) / rate(aikp_rag_retrieval_latency_seconds_count[1m])",
          "legendFormat": "Retrieval Latency"
        },
        {
          "expr": "rate(aikp_rag_generation_latency_seconds_sum[1m]) / rate(aikp_rag_generation_latency_seconds_count[1m])",
          "legendFormat": "Generation Latency"
        },
        {
          "expr": "rate(aikp_rag_total_latency_seconds_sum[1m]) / rate(aikp_rag_total_latency_seconds_count[1m])",
          "legendFormat": "Total RAG Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 8,
      "title": "Redis Cache Hit / Miss Rate",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(aikp_cache_hits_total[1m])) by (cache)",
          "legendFormat": "Hit ({{cache}})"
        },
        {
          "expr": "sum(rate(aikp_cache_misses_total[1m])) by (cache)",
          "legendFormat": "Miss ({{cache}})"
        }
      ]
    },
    {
      "id": 9,
      "title": "Document Processing & Failures",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(aikp_documents_processed_total[1m])) by (status)",
          "legendFormat": "Processed ({{status}})"
        },
        {
          "expr": "sum(rate(aikp_documents_failed_total[1m])) by (phase)",
          "legendFormat": "Failed Doc Phase ({{phase}})"
        },
        {
          "expr": "rate(aikp_kafka_processing_failures_total[1m])",
          "legendFormat": "Kafka Processing Failures"
        }
      ]
    }
